# ---- Supabase ----
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe ----
# Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for the three monthly plans (Products → Pricing)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...

# ---- Grok (xAI) ----
GROK_API_KEY=xai-...
GROK_MODEL=grok-3
# Optional: Ad Poster image model (default grok-imagine-image)
GROK_IMAGE_MODEL=grok-imagine-image

# ---- App ----
# Public base URL (no trailing slash). Local: http://localhost:3000
# Production: https://MakeItRainApp.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Founder signup alerts + counter ----
# Secret for /admin/signups?key=... and /api/admin/signups?key=...
ADMIN_STATS_SECRET=pick-a-long-random-string
# Where to email on every new signup
ADMIN_NOTIFY_EMAIL=you@example.com
# Resend.com API key (https://resend.com/api-keys)
RESEND_API_KEY=re_...
# Optional. Default works for Resend test sends to your own verified email.
# RESEND_FROM_EMAIL=Make it RAIN <onboarding@resend.dev>

# ---- Apollo (Find Your Buyers → matching leads) ----
# Master API key required for people search. Same key RoleFerry uses.
APOLLO_API_KEY=
