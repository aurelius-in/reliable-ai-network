# ---- Supabase ----
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe ----
# Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for the three monthly plans (Products → Pricing)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...

# ---- Grok (xAI) ----
GROK_API_KEY=xai-...
GROK_MODEL=grok-3

# ---- App ----
# Public base URL (no trailing slash). Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
